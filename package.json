{
  "name": "trading-journal",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "vite",
    "dev:web": "vite --open --host",
    "convex:pull-external-types": "npx convex-helpers ts-api-spec --output-file convex/_external_types/tradingview_image_alert_types",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "tsc && vite build",
    "build:electron": "electron-builder",
    "build:rasp": "npm run build:web -- --mode production && npx electron-builder --linux --publish always",
    "build:prod": "npm run build:web -- --mode production && npx electron-builder --publish always",
    "build:dev": "npm run build:web -- --mode development && npm run build:electron",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "db:flush": "npx convex dev --reset",
    "set-version": "npm version --no-git-tag-version"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.42",
    "@ai-sdk/openai-compatible": "^1.0.19",
    "@blocknote/core": "^0.40.0",
